--synthesis_resources = lut 8 
SUBDESIGN decode_f7a
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[5..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[5..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode426w[3..0]	: WIRE;
	w_anode443w[3..0]	: WIRE;
	w_anode453w[3..0]	: WIRE;
	w_anode463w[3..0]	: WIRE;
	w_anode473w[3..0]	: WIRE;
	w_anode483w[3..0]	: WIRE;
	w_anode493w[3..0]	: WIRE;
	w_anode503w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[5..0] = eq_wire[5..0];
	eq_wire[] = ( w_anode503w[3..3], w_anode493w[3..3], w_anode483w[3..3], w_anode473w[3..3], w_anode463w[3..3], w_anode453w[3..3], w_anode443w[3..3], w_anode426w[3..3]);
	w_anode426w[] = ( (w_anode426w[2..2] & (! data_wire[2..2])), (w_anode426w[1..1] & (! data_wire[1..1])), (w_anode426w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode443w[] = ( (w_anode443w[2..2] & (! data_wire[2..2])), (w_anode443w[1..1] & (! data_wire[1..1])), (w_anode443w[0..0] & data_wire[0..0]), enable_wire);
	w_anode453w[] = ( (w_anode453w[2..2] & (! data_wire[2..2])), (w_anode453w[1..1] & data_wire[1..1]), (w_anode453w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode463w[] = ( (w_anode463w[2..2] & (! data_wire[2..2])), (w_anode463w[1..1] & data_wire[1..1]), (w_anode463w[0..0] & data_wire[0..0]), enable_wire);
	w_anode473w[] = ( (w_anode473w[2..2] & data_wire[2..2]), (w_anode473w[1..1] & (! data_wire[1..1])), (w_anode473w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode483w[] = ( (w_anode483w[2..2] & data_wire[2..2]), (w_anode483w[1..1] & (! data_wire[1..1])), (w_anode483w[0..0] & data_wire[0..0]), enable_wire);
	w_anode493w[] = ( (w_anode493w[2..2] & data_wire[2..2]), (w_anode493w[1..1] & data_wire[1..1]), (w_anode493w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode503w[] = ( (w_anode503w[2..2] & data_wire[2..2]), (w_anode503w[1..1] & data_wire[1..1]), (w_anode503w[0..0] & data_wire[0..0]), enable_wire);
END;
